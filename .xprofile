# settings
xrandr --output LVDS-1 --set "scaling mode" "Full"
xset +dpms s blank s on

# services
numlockx &
xbindkeys -f $HOME/.config/xbindkeys/config &
dunst -conf $HOME/.config/dunst/dunstrc &
xcompmgr &
snixembed --fork &

# audio
mpd &
mpdscribble --conf $HOME/.config/mpdscribble/mpdscribble.conf &
easyeffects --hide-window --load-preset "gass" &

# visuals
#xwallpaper --zoom /usr/share/backgrounds/arch-linux-2d/Arch1.jpg &
xwallpaper --zoom $HOME/Pictures/paintings/surf-on-rocks-dithered.png &
#$HOME/.local/scripts/dwm-statusbar.sh &
modbar &
conky &

# applets
#nm-applet &
blueman-applet &

# scripts
$HOME/.local/scripts/battery-brighness.sh &
dmenu_path >/dev/null & # making dmenu cache, cuz first runs are often slow

# env
if read -r init </proc/1/comm && [ "$init" = "systemd" ]; then
    systemctl --user import-environment DISPLAY XAUTHORITY
fi
