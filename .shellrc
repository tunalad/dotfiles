#
# ~/.shellrc
#

# if interactive shell, skip all
case $- in *i*) ;; *) return ;; esac

PS1='[\u@\h \W]\$ '

# shell configs
[ -f /etc/os-release ] && . /etc/os-release
DISTRO=${ID:-arch}

SHELL_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shell"

. "$SHELL_DIR/aliases.sh"
. "$SHELL_DIR/functions.sh"
. "$SHELL_DIR/style/${DISTRO}.sh"

# bash specific:
if [ -n "$BASH_VERSION" ]; then
    # completions
    lazy_load_completion yt-dlp /usr/share/bash-completion/completions/yt-dlp
    lazy_load_completion tmux /usr/share/bash-completion/completions/tmux
    lazy_load_completion git /usr/share/bash-completion/completions/git
    complete -cf doas

    # binds
    bind "set colored-completion-prefix on"
    bind "set colored-stats on"
    bind -x '"\C-r": fzf_history'
fi

# starting tmux if not in tty
if [ -z "$TMUX" ] && [ "$TERM" != "linux" ]; then
    tmux -f "$XDG_CONFIG_HOME/tmux/tmux.conf" -f "$XDG_CONFIG_HOME/tmux/style/${DISTRO}.conf" new-session
fi

#nsp -r
